{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "321 hook claude_code iz4 filesystem_guard",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "321 hook claude_code iz4 shell_guard",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "321 hook claude_code iz4 authoritative_context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "321 hook claude_code iz4 post_run",
            "type": "command"
          }
        ]
      }
    ]
  }
}
