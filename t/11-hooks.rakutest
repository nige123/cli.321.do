# Harness hooks: wiring a hook command into Claude Code's settings, merging
# and idempotent, and the doctor's JSON that says what each adapter enforces.
use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use Do321Test;
use Do321ControlTest;
use Do321::JSON;
use Do321::Protocol;
use Do321::Hooks;
use Do321::Wire;

my $ws = temp-dir();
my $settings = $ws.add('.claude/settings.json');

# ---- the older direct wiring: read and removed, never written ----------------
# 321 before 0.4 (and iz4 before 0.15) wrote a controller's own command
# into the harness.  The fixture writes exactly that; 321 itself no longer can.
legacy-wiring($ws, :!strict);
my $parsed = parse-json($settings.slurp);
is $parsed<hooks><SessionStart>[0]<hooks>[0]<command>, 'iz4 hook session-start', 'an advisory older wiring has session start';
my %status = claude-hooks-status($ws, 'iz4 hook');
ok %status<session-start> && !%status<pre-edit> && !%status<stop>, 'and status sees exactly that';
$settings.unlink;
legacy-wiring($ws);
%status = claude-hooks-status($ws, 'iz4 hook');
ok %status<session-start> && %status<pre-edit> && %status<stop>, 'a strict older wiring: status sees all three';

# entries that are not ours survive, and only ours are removed
my %other = parse-json($settings.slurp);
%other<permissions> = { allow => ['Bash(ls:*)'] };
%other<hooks><Stop>.unshift(%( hooks => [ %( type => 'command', command => 'other-tool stop' ), ] ));
%other<hooks><PreToolUse>.unshift(%( matcher => 'Bash', hooks => [ %( type => 'command', command => 'lint' ), ] ));
$settings.spurt(settings-json(%other));
is remove-claude-hooks($ws, 'iz4 hook'), 'removed', 'remove takes ours away';
$parsed = parse-json($settings.slurp);
is $parsed<permissions><allow>[0], 'Bash(ls:*)', 'other settings stay';
is $parsed<hooks><Stop>.elems, 1, 'the other stop hook stays';
is $parsed<hooks><Stop>[0]<hooks>[0]<command>, 'other-tool stop', 'and it is theirs';
is $parsed<hooks><PreToolUse>[0]<hooks>[0]<command>, 'lint', 'so does the other pre-edit hook';
ok !$parsed<hooks><SessionStart>.defined, 'ours is gone';
is remove-claude-hooks($ws, 'iz4 hook'), 'unchanged', 'a second remove changes nothing';
%status = claude-hooks-status($ws, 'iz4 hook');
ok !%status<session-start> && !%status<pre-edit> && !%status<stop>, 'status sees nothing of ours';

# an unparseable settings file is never touched
$settings.spurt('{ not json');
throws-like { remove-claude-hooks($ws, 'iz4 hook') }, Exception, message => /'not valid JSON'/, 'a broken file is refused';
is $settings.slurp, '{ not json', 'and left alone';
$settings.unlink;

# ---- the records ------------------------------------------------------------------
legacy-wiring($ws);
my @st = status-all($ws, 'iz4 hook');
is @st.elems, 1, 'one known harness';
my %r = @st[0];
is %r<harness>, 'claude_code', 'claude_code';
ok !%r<action>.defined && %r<events><pre-edit> eq 'wired' && %r<events><stop> eq 'wired', 'status records carry no action';
is %r<enforced>.join(','), 'pre-edit,stop', 'pre-edit and stop refuse';
is %r<advisory>.join(','), 'session-start', 'session start only injects';
my @rm = remove-all($ws, 'iz4 hook');
is @rm[0]<action>, 'removed', 'remove records';
is @rm[0]<enforced>.elems, 0, 'and nothing is enforced afterwards';

# ---- 321 holds nothing that writes a controller's own command into a harness ---
nok 'lib/Do321/Hooks.rakumod'.IO.slurp ~~ / 'sub install' /, 'the older hooks module has no installer';

# ---- through the CLI -----------------------------------------------------------
my $cws = temp-dir();
my ($rc, $out, $err) = x321('hooks', 'install', '--workspace', $cws.Str, '--command', 'iz4 hook', '--strict', '--json');
is $rc, EXIT-FAILED, 'hooks install is refused: 321 no longer writes a controller\'s own command into a harness';
my $doc = parse-json($out);
is $doc<schema>, 'hooks.v1', 'still a hooks.v1 document, for an older caller to read';
is $doc<harnesses>[0]<action>, 'refused', 'the action is refused';
like $doc<harnesses>[0]<error>, /'hooks 321 installs call 321' .* '321 iz4 install'/, 'and it says what to use instead';
nok $cws.add('.claude/settings.json').e, 'nothing was written';
my $before = legacy-wiring($cws).slurp;
($rc, $out, $err) = x321('hooks', 'install', '--workspace', $cws.Str, '--command', 'iz4 hook', '--strict');
is $cws.add('.claude/settings.json').slurp, $before, 'and an older wiring already there is left byte for byte';
ok $out.contains('stop: wired'), 'while the refusal still reports what is there';
($rc, $out, $err) = x321('hooks', 'status', '--workspace', $cws.Str, '--command', 'iz4 hook');
ok $rc == 0 && $out.contains('claude_code') && $out.contains('stop: wired') && $out.contains('enforced: pre-edit, stop'), 'status in text' or diag $out;
($rc, $out, $err) = x321('hooks', 'remove', '--workspace', $cws.Str, '--command', 'iz4 hook');
ok $rc == 0 && $out ~~ /'claude_code' .* 'removed'/, 'remove in text';
($rc, $out, $err) = x321('hooks', 'install', '--workspace', $cws.Str);
ok $rc == EXIT-USAGE && $err.contains('--command'), 'the command is required';
($rc, $out, $err) = x321('hooks', 'bogus', '--workspace', $cws.Str, '--command', 'x');
is $rc, EXIT-USAGE, 'an unknown subcommand is a usage error';

# ---- doctor --json ---------------------------------------------------------------
($rc, $out, $err) = x321('doctor', '--json');
is $rc, 0, 'doctor --json exits 0' or diag $err;
$doc = parse-json($out);
is $doc<schema>, 'doctor.v1', 'a doctor.v1 document';
my %by = $doc<adapters>.map({ .<name> => $_ });
ok %by<claude_code>.defined, 'claude_code is listed';
ok %by<claude_code><enforces><tool_allowlist> && !%by<claude_code><enforces><network_deny>, 'with what it enforces and what it does not';
is %by<claude_code><hooks><stop>, 'refuses', 'and which hook events refuse';
is %by<claude_code><hooks><session-start>, 'advises', 'or only advise';
ok %by<procedure><hooks>.elems == 0, 'the procedure executor is not a harness people drive';
ok $doc<tools>.elems == 1 && $doc<tools>[0].starts-with('dp:'), 'the tool bindings';
ok $doc<trust><path>.defined && $doc<iz4><binary>.defined, 'trust and iz4 are reported';
is %by<claude_code><controls><filesystem_guard>, 'enforces', 'doctor says per control what the harness can do: a write can be refused';
is %by<claude_code><controls><authoritative_context>, 'advises', 'the context is told, not enforced';
is %by<claude_code><controls><network_guard>, 'none', 'and network use cannot be intercepted at all';
is %by<claude_code><headlessControls><human_approval>, 'none', 'headless, nobody can be asked';
ok !%by<procedure><controls>.defined, 'an adapter with no controls reports none';
ok ($doc<iz4><drivable>:exists) && ($doc<iz4><reason>:exists), 'whether iz4 can be driven is reported, with the reason when it cannot';
{
    # an iz4 that is installed but has no machine interface is not "applied"
    my $old = stub-iz4();
    my ($rc, $out, $err) = x321('doctor', '--json', :env(%( X321_IZ4 => $old, STUB_OLD => '1' )));
    my $d = parse-json($out);
    ok $d<iz4><binary> ne '' && !$d<iz4><drivable> && !$d<iz4><applied>, 'an iz4 that cannot be driven is installed and not applied';
    like $d<iz4><reason>, /'no machine interface'/, 'and doctor says why';
    ($rc, $out, $err) = x321('doctor', :env(%( X321_IZ4 => $old, STUB_OLD => '1' )));
    like $out, /'is installed but cannot be driven'/, 'in text too';
    ($rc, $out, $err) = x321('doctor', '--json', :env(%( X321_IZ4 => stub-iz4() )));
    ok parse-json($out)<iz4><drivable>, 'a drivable iz4 is reported as such';
}

done-testing;
