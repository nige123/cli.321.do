# Copyright Nige Ltd. Author: Nigel Hamilton.
# The front door for harness knowledge: detecting harnesses, installing a
# controller into one, saying what is enforced, taking it out again, and
# the glue command a harness calls.  Everything here goes through bin/321.
use lib $?FILE.IO.parent.add('lib').Str;
use Test;
use Do321Test;
use Do321ControlTest;
use Do321::JSON;
use Do321::Protocol;
use Do321::Wire;
use Do321::ClaudeHooks;

my %base = DO_321_IZ4 => stub-iz4(), DO_321_CLAUDE_BINARY => fake-claude().Str;
sub c(*@args, :%env, Str :$in = '', IO::Path :$cwd) { x321(|@args, :env(%( |%base, |%env )), :$in, |($cwd ?? (:$cwd) !! ())) }
sub settings(IO::Path $ws) { parse-json($ws.add('.claude/settings.json').slurp) }

# ---- harness detect -----------------------------------------------------------------
{
    my $ws = iz4-workspace();
    my ($rc, $out, $err) = c('harness', 'detect', '--workspace', $ws.Str);
    is $rc, 0, 'harness detect' or diag $err;
    like $out, /^^ \s* 'claude_code' \s+ 'detected'/, 'Claude Code is detected';
    ok $out.contains('.claude/settings.json (none yet)'), 'and that this project has no wiring yet';
    ok !$out.lines.grep(/^ \s* ['procedure' | 'fake'] \s/), 'adapters that are not harnesses are not listed';
    unlike $out, /'enforces:'/, 'the controls stay one step away';
    ($rc, $out, $err) = c('harness', 'detect', '--workspace', $ws.Str, '--verbose');
    like $out, /'enforces:' .* 'filesystem_guard'/, '--verbose says what it enforces';
    like $out, /'cannot:' .* 'network_guard'/, 'and what it cannot do';

    ($rc, $out, $err) = c('harness', 'detect', '--workspace', $ws.Str, '--json');
    my %d = parse-json($out);
    is %d<schema>, 'harness-detect.v1', 'as a versioned document';
    my %h = %d<harnesses>[0];
    ok %h<harness> eq 'claude_code' && %h<detected> && %h<controls><network_guard> eq 'none' && %h<controls><shell_guard> eq 'enforces', 'carrying every control\'s strength';
    ok %h<controls><human_approval> eq 'enforces' && %h<headless><human_approval> eq 'none', 'interactive and headless told apart';

    ($rc, $out, $err) = c('harness', 'detect', :env(%( DO_321_CLAUDE_BINARY => '/no/such/claude' )));
    like $out, /'claude_code' \s+ 'not detected'/, 'a harness that is not here is reported as not detected';
    is c('harness')[0], EXIT-USAGE, 'harness needs a subcommand';
}

# ---- what is not wired is said, not left out ----------------------------------------
{
    my $ws = iz4-workspace();
    my $bin = temp-dir();
    for <codex gemini> -> $n { $bin.add($n).spurt("#!/bin/sh\necho stand-in\n"); $bin.add($n).chmod(0o755) }
    my %env = DO_321_CODEX_BINARY => $bin.add('codex').Str, PATH => "{$bin.Str}:/usr/bin:/bin";
    my ($rc, $out, $err) = c('iz4', 'status', '--workspace', $ws.Str, :%env);
    like $out, /^^ \s+ 'codex' \s+ 'runs under 321, but nothing checks the turn end' /, 'a harness 321 runs but cannot hook is named, with the gap' or diag "$out $err";
    like $out, /^^ \s+ 'gemini' \s+ 'not known to 321: nothing is checked there' /, 'and one it does not know';
    ($rc, $out, $err) = c('--json', 'iz4', 'status', '--workspace', $ws.Str, :%env);
    is parse-json($out)<unwired>.map(*<harness>).sort.join(','), 'codex,gemini', 'the --json form lists them too';
    ($rc, $out, $err) = c('iz4', 'status', '--workspace', $ws.Str, :env(%( DO_321_CODEX_BINARY => '/nowhere/codex', PATH => '/usr/bin:/bin' )));
    nok $out.contains('codex ') || $out.contains('gemini'), 'and a harness that is not here is not mentioned' or diag $out;
}

# ---- install, status, remove ---------------------------------------------------------
{
    my $ws = iz4-workspace();
    my ($rc, $out, $err) = c('iz4', 'status', '--workspace', $ws.Str, '--verbose');
    is $rc, 0, 'status' or diag $err;
    ok $out.contains('Project: IZ4 enabled') && $out.contains('Effective enforcement: NONE'), 'before installing, nothing is enforced';
    like $out, /^^ 'Filesystem guard' \s+ 'not installed' $$/, 'and the status says what is not installed';

    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--verbose');
    is $rc, 0, 'install' or diag "$out\n$err";
    like $out, / 'claude_code' \s+ 'installed (.claude/settings.json); guarded: context delivered, edits and shell held, the turn end checked' /, 'it says what it did and where, in one row' or diag $out;
    ok $out.contains('All wired: IZ4 is guarded in claude_code'), 'and that everything is in place, plainly';
    like $out, /^^ 'Context injection' \s+ 'yes (told to the agent; nothing is refused)' $$/, 'context: yes, and called what it is';
    like $out, /^^ 'Filesystem guard' \s+ 'yes' $$/, 'write guard: yes';
    like $out, /^^ 'Shell guard' \s+ 'yes' $$/, 'shell guard: yes';
    like $out, /^^ 'Post-run verification' \s+ 'yes' $$/, 'final verification: yes';
    like $out, /^^ 'Network interception' \s+ 'no' $$/, 'network: no';
    ok $out.contains('Effective enforcement: GUARDED (aware, checked, guarded)'), 'the headline, and what it is made of';
    ok $out.contains('Network interception is not available in claude_code'), 'with the warning';
    my @cmds = settings($ws)<hooks>.values.map({ |@$_ }).map({ |@($_<hooks>) }).map(*<command>);
    is @cmds.grep(*.starts-with('321 hook claude_code iz4 ')).elems, 4, 'the project\'s settings call 321 by name, so they work on any machine';

    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--verbose');
    ok $rc == 0 && $out.contains('unchanged; guarded'), 'installing again changes nothing';

    ($rc, $out, $err) = c('iz4', 'status', '--workspace', $ws.Str, '--json');
    my %d = parse-json($out);
    is %d<schema>, 'enforcement-report.v1', 'status as a document';
    my %s = %d<harnesses>[0];
    ok %s<harness> eq 'claude_code' && %s<headline> eq 'GUARDED' && %s<levels>.join(',') eq 'aware,checked,guarded', 'with the levels as separate facts';
    ok %s<controls>.first({ .<control> eq 'network_guard' })<harness> eq 'none', 'and each control\'s state';
    ok %s<subject>.ends-with('/IZ4') && %s<digest> eq 'sha256:abc123', 'and which IZ4, by digest';

    ($rc, $out, $err) = c('iz4', 'remove', '--workspace', $ws.Str, '--verbose');
    ok $rc == 0 && $out.contains('removed; none: no context, no action checked, the turn end unchecked') && $out.contains('Effective enforcement: NONE'), 'remove takes it out and says so' or diag $out;
    ok !(settings($ws)<hooks>:exists), 'the settings are clean again';

    # advisory: the context only, and it is called what it is
    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--advisory', '--verbose');
    ok $rc == 0 && $out.contains('Effective enforcement: AWARE (aware)'), 'an advisory install is AWARE, and says no more' or diag $out;
    like $out, /^^ 'Filesystem guard' \s+ 'not installed' $$/, 'the guards are reported as not installed';
    is settings($ws)<hooks>.keys.join(','), 'SessionStart', 'only the context hook is wired';
    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--verbose');
    ok $out.contains('updated (.claude/settings.json); guarded') && $out.contains('GUARDED'), 'a full install afterwards upgrades it' or diag $out;
    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--advisory', '--verbose');
    ok $out.contains('unchanged; guarded') && $out.contains('Effective enforcement: GUARDED'), 'an advisory install afterwards never takes the guards out' or diag $out;
    c('iz4', 'remove', '--workspace', $ws.Str, '--verbose');
    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--advisory', '--verbose');
    ok $out.contains('Effective enforcement: AWARE'), 'stepping down is a remove and then an advisory install';
    c('iz4', 'remove', '--workspace', $ws.Str, '--verbose');

    # a settings file that cannot be parsed: failure, loudly, nothing claimed
    $ws.add('.claude/settings.json').spurt('{ nope');
    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--verbose');
    is $rc, EXIT-FAILED, 'a failed install exits as a failure';
    ok $out.contains('failed; none') && $out.contains('! ') && $out.contains('not a JSON object') && $out.contains('Effective enforcement: NONE'), 'says why, and claims nothing' or diag $out;
}

# ---- no IZ4, unknown harness, a harness that is not here ---------------------------
{
    my $bare = iz4-workspace(:!iz4);
    my ($rc, $out, $err) = c('iz4', 'install', '--workspace', $bare.Str);
    ok $rc == 0 && $out.contains('no IZ4 here: nothing to enforce'), 'no IZ4: nothing is installed, and that is fine' or diag $out;
    ok !$bare.add('.claude').e, 'and nothing was written';
    my $ws = iz4-workspace();
    ($rc, $out, $err) = c('iz4', 'status', '--workspace', $ws.Str, '--harness', 'codex', '--verbose');
    ok $rc == EXIT-USAGE && $err.contains('no harness "codex"'), 'a harness 321 does not know is an error, not a pretend adapter';
    ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, :env(%( DO_321_CLAUDE_BINARY => '/no/such/claude' )), '--verbose');
    ok $rc == 0 && $out.contains('harness not detected here') && $out.contains('was not detected here'), 'a known harness that is not installed can still be wired, and the status says it is absent' or diag $out;
    is c('iz4')[0], EXIT-USAGE, 'iz4 needs a subcommand';
}

# ---- a harness with fewer capabilities ---------------------------------------------
{
    my $ws = iz4-workspace();
    my %weak = DO_321_FAKE_CONTROLS => encode-json(%( authoritative_context => 'advises', post_run => 'enforces' ));
    my ($rc, $out, $err) = c('iz4', 'install', '--workspace', $ws.Str, '--harness', 'fake', :env(%weak), '--verbose');
    is $rc, 0, 'install into a weaker harness' or diag "$out\n$err";
    ok $out.contains('Effective enforcement: CHECKED (aware, checked)'), 'CHECKED, not GUARDED';
    like $out, /^^ 'Context injection' \s+ 'yes (told to the agent; nothing is refused)' $$/, 'a context is told, never said to be enforced';
    like $out, /^^ 'Filesystem guard' \s+ 'no' $$/, 'there is no write guard';
    ok $out.contains('Filesystem guard is not available in fake'), 'and the warning says so';
    ($rc, $out, $err) = c('harness', 'detect', :env(%weak));
    like $out, /^^ \s* 'fake' \s+ 'detected'/, 'a stand-in harness with controls is listed as one';
}

# ---- the glue: 321 hook ---------------------------------------------------------------
{
    my $ws = iz4-workspace();
    my $log = temp-dir().add('hooks.ndjson');
    my sub hook(Str $control, %native, *%env) { c('hook', 'claude_code', 'iz4', $control, :in(encode-json(%( cwd => $ws.Str, |%native ))), :env(%( DO_321_HOOK_LOG => $log.Str, |%env ))) }
    my %write = tool_name => 'Write', tool_input => %( file_path => $ws.add('lib/a.txt').Str, content => 'hello' );

    # context
    my ($rc, $out, $err) = hook('authoritative_context', %( hook_event_name => 'SessionStart' ));
    ok $rc == 0 && $out.contains('These invariants govern this work (stub)'), 'at a session\'s start the glue prints iz4\'s context' or diag "$out $err";

    # a write that passes: silent
    my $seen = temp-dir().add('action.json');
    ($rc, $out, $err) = hook('filesystem_guard', %write, STUB_ACTION_IN => $seen.Str);
    ok $rc == 0 && $out eq '' && $err eq '', 'a passing write goes through silently' or diag "$out $err";
    my %a = parse-json($seen.slurp);
    ok %a<operation> eq 'write' && %a<target>.ends-with('lib/a.txt') && %a<parameters><content> eq 'hello' && %a<repository> eq $ws.Str,
        'iz4 was asked about a generic action, not a Claude Code event' or diag %a.raku;
    ok !(%a<tool_name>:exists) && !(%a<tool_input>:exists), 'no harness vocabulary reached iz4';

    # block
    ($rc, $out, $err) = hook('filesystem_guard', %write, STUB_ACTION => 'block');
    ok $rc == 2 && $err.contains('action block'), 'a block refuses the tool call, with the reason for the model';

    # needs a person: asked at an interactive session, refused in a headless run
    ($rc, $out, $err) = hook('filesystem_guard', %write, STUB_ACTION => 'needs_human');
    is $rc, 0, 'needs_human at an interactive session does not refuse outright';
    my %j = parse-json($out);
    ok %j<hookSpecificOutput><permissionDecision> eq 'ask' && %j<hookSpecificOutput><permissionDecisionReason>.contains('iz4 approve'), 'it asks the person, showing how agreement is recorded';
    ($rc, $out, $err) = hook('filesystem_guard', %write, STUB_ACTION => 'needs_human', DO_321_HEADLESS => '1');
    ok $rc == 2 && $err.contains('put the proposal to a person'), 'headless, it refuses and says to take it to a person';

    # warn
    ($rc, $out, $err) = hook('shell_guard', %( tool_name => 'Bash', tool_input => %( command => 'make test' ) ), STUB_ACTION => 'warn');
    ok $rc == 0 && parse-json($out)<hookSpecificOutput><additionalContext> eq 'action warn', 'a warning lets the command run and tells the model why';

    # end of a turn: the agent's last words go to iz4, from Claude Code's own transcript
    my $t = temp-dir().add('t.jsonl');
    $t.spurt(encode-json(%( type => 'user', message => %( content => 'do it' ) )) ~ "\n"
           ~ encode-json(%( type => 'assistant', message => %( content => [ %( type => 'text', text => 'first thoughts' ), ] ) )) ~ "\n"
           ~ encode-json(%( type => 'assistant', message => %( content => [ %( type => 'tool_use', name => 'Write' ), %( type => 'text', text => 'All done, no report.' ) ] ) )) ~ "\n");
    my $said = temp-dir().add('said.txt');
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str ), STUB_VERIFY => 'block', STUB_SUMMARY_OUT => $said.Str);
    ok $rc == 2 && $err.contains('verify block'), 'a turn that ends without passing is refused, so the agent says what is outstanding';
    ok $err.starts-with('IZ4: verify block') && $err.lines.elems == 1, 'the refusal is iz4\'s one line, named as iz4\'s, with nothing appended' or diag $err;
    is $said.slurp, 'All done, no report.', 'iz4 was given the last thing the assistant said, as plain text';
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str, stop_hook_active => True ), STUB_VERIFY => 'block');
    is $rc, 0, 'asked a second time in the same turn, the glue lets it end: an agent is never trapped';
    $said.unlink;
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str, stop_hook_active => True ), STUB_SUMMARY_OUT => $said.Str);
    ok $rc == 0 && $said.e, 'and iz4 is still asked, so its last word does not go on showing a refusal put right' or diag "$rc $err";
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str ));
    is $rc, 0, 'a turn that verifies ends normally';
    # everything held and the report is in: nothing waits on the person, so nothing is said at the turn end
    ok $out eq '' && $err eq '', 'a clean turn end is quiet; the status line says what held' or diag "$out $err";
    # the status line: iz4's last result as iz4 wrote it, from the workspace Claude Code is in
    $ws.add('.git').add('iz4').mkdir;
    $ws.add('.git').add('iz4').add('last.json').spurt(encode-json(%( schema => 'iz4-last/1', result => 'pass', line => '◈ IZ4: all held' )));
    ($rc, $out, $err) = c('hook', 'claude_code', 'iz4', 'status_line', :in(encode-json(%( workspace => %( current_dir => $ws.Str ) ))));
    ok $rc == 0 && $out eq "◈ IZ4: all held\n" && $err eq '', 'the status line shows iz4\'s last line, word for word' or diag "$rc $out $err";
    ($rc, $out, $err) = c('hook', 'claude_code', 'iz4', 'status_line', :in(encode-json(%( workspace => %( current_dir => temp-dir().Str ) ))));
    ok $rc == 0 && $out eq '' && $err eq '', 'and nothing where there is no result' or diag "$rc $out $err";
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str ), STUB_REPORT => 'not_checked');
    ok $rc == 0 && $out eq '' && $err eq '', 'a turn that owed no report ends in silence' or diag "$out $err";

    # the log: how a run proves its hooks fired
    my @lines = $log.lines.map({ parse-json($_) });
    is @lines.elems, 11, 'every call was logged';
    ok @lines.grep({ .<control> eq 'filesystem_guard' && .<result> eq 'block' && .<controller> eq 'iz4' && .<harness> eq 'claude_code' }), 'with controller, harness, control and result';
    ok @lines.grep({ .<control> eq 'post_run' && .<point> eq 'verify' }) && @lines.grep({ .<control> eq 'authoritative_context' && .<point> eq 'context' }), 'and the point each answered';

    # a turn that used no tool able to change files owes nothing: iz4 is not asked
    my $calls = temp-dir().add('calls.log');
    my $quiet = temp-dir().add('quiet.jsonl');
    $quiet.spurt($t.slurp
           ~ encode-json(%( type => 'user', message => %( content => 'and now a question' ) )) ~ "\n"
           ~ encode-json(%( type => 'assistant', message => %( content => [ %( type => 'tool_use', name => 'Read' ), %( type => 'tool_use', name => 'Grep' ) ] ) )) ~ "\n"
           ~ encode-json(%( type => 'user', toolUseResult => %( ok => True ), message => %( content => [ %( type => 'tool_result', content => 'x' ), ] ) )) ~ "\n"
           ~ encode-json(%( type => 'assistant', message => %( content => [ %( type => 'text', text => 'Here is the answer.' ), ] ) )) ~ "\n");
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $quiet.Str ), STUB_VERIFY => 'block', STUB_LOG => $calls.Str);
    ok $rc == 0 && $out eq '' && $err eq '', 'a turn of reading and answering ends in silence even when verify would block' or diag "$out $err";
    ok !$calls.e || !$calls.lines.grep(*.starts-with('verify')), 'and iz4 verify was not run' or diag $calls.slurp;
    ok parse-json($log.lines.tail)<reason>.contains('not asked'), 'the log says it was not asked, not that it passed a check' or diag $log.lines.tail;
    # the earlier turn's Write still counts when it is the turn ending
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str ), STUB_VERIFY => 'block', STUB_LOG => $calls.Str);
    ok $rc == 2 && $calls.lines.grep(*.starts-with('verify')), 'a turn that wrote is verified' or diag $calls.slurp;
    # a delegated agent, or a tool 321 has never heard of, may have written: asked
    my $delegated = temp-dir().add('delegated.jsonl');
    $delegated.spurt(encode-json(%( type => 'user', message => %( content => 'go' ) )) ~ "\n"
           ~ encode-json(%( type => 'assistant', message => %( content => [ %( type => 'tool_use', name => 'Agent' ), ] ) )) ~ "\n");
    $calls.unlink;
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $delegated.Str ), STUB_LOG => $calls.Str);
    ok $calls.lines.grep(*.starts-with('verify')), 'an unknown or delegating tool counts as able to change files' or diag $calls.slurp;
    $calls.unlink;
    ($rc, $out, $err) = hook('post_run', %( ), STUB_LOG => $calls.Str);
    ok $calls.lines.grep(*.starts-with('verify')), 'no transcript: asked' or diag $calls.slurp;

    # the baseline: a turn is measured from the tree it began with, not from HEAD
    my $tree0 = 'a' x 40; my $tree1 = 'b' x 40;
    my %sess = session_id => 'sess-1';
    $calls.unlink;
    ($rc, $out, $err) = hook('authoritative_context', %( hook_event_name => 'SessionStart', |%sess ), STUB_TREE => $tree0, STUB_LOG => $calls.Str);
    ok $rc == 0 && $calls.lines.grep(*.starts-with('check change --worktree --json --/checks')), 'at session start the tree is read without running any check' or diag $calls.slurp;
    $calls.unlink;
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str, |%sess ), STUB_VERIFY => 'block', STUB_TREE => $tree1, STUB_LOG => $calls.Str);
    ok $rc == 2 && $calls.lines.grep({ $_ eq "verify --worktree --json --base=$tree0 " || .starts-with("verify --worktree --json --base=$tree0 --summary=") }), 'verify measures from the session\'s baseline' or diag $calls.slurp;
    $calls.unlink;
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str, |%sess ), STUB_TREE => $tree1, STUB_LOG => $calls.Str);
    ok $rc == 0 && $calls.lines.grep(*.contains("--base=$tree0")), 'refused, the baseline stayed where it was: the same changes are measured again' or diag $calls.slurp;
    $calls.unlink;
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str, |%sess ), STUB_TREE => $tree1, STUB_LOG => $calls.Str);
    ok $rc == 0 && $calls.lines.grep(*.contains("--base=$tree1")), 'allowed to end, the next turn is measured from where this one left the tree' or diag $calls.slurp;
    $calls.unlink;
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str, session_id => 'sess-2' ), STUB_LOG => $calls.Str);
    ok $calls.lines.grep({ .starts-with('verify') && !.contains('--base=') }), 'a session without a baseline measures from HEAD, as before' or diag $calls.slurp;

    # an unapproved change stays in view, however many turns pass
    my %s3 = session_id => 'sess-3';
    hook('authoritative_context', %( hook_event_name => 'SessionStart', |%s3 ), STUB_TREE => $tree0);
    hook('post_run', %( transcript_path => $t.Str, |%s3 ), STUB_VERIFY => 'block', STUB_TREE => $tree1);
    my $read-only = temp-dir().add('read-only.jsonl');
    $read-only.spurt(encode-json(%( type => 'user', message => %( content => 'what now?' ) )) ~ "\n" ~ encode-json(%( type => 'assistant', message => %( content => [ %( type => 'text', text => 'This.' ), ] ) )) ~ "\n");
    $calls.unlink;
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $read-only.Str, |%s3 ), STUB_VERIFY => 'block', STUB_LOG => $calls.Str);
    ok $rc == 0 && !$calls.lines.grep(*.starts-with('verify')), 'a turn of reading is not asked for a report' or diag "$rc $err";
    ($rc, $out, $err) = hook('post_run', %( transcript_path => $t.Str, |%s3 ), STUB_VERIFY => 'block', STUB_TREE => $tree1, STUB_LOG => $calls.Str);
    ok $rc == 2 && $calls.lines.grep(*.contains("--base=$tree0")), 'and it clears nothing: the same change is measured from the same place' or diag $calls.slurp;

    # a prompt typed while the assistant was busy comes as an attachment
    {
        my $q = temp-dir().add('queued.jsonl');
        my $line = -> $name, $text { encode-json(%( type => 'assistant', message => %( content => [ $name ?? %( type => 'tool_use', name => $name ) !! %( type => 'text', text => $text ), ] ) )) };
        my $queued = encode-json(%( type => 'attachment', attachment => %( type => 'queued_command', prompt => 'what was the bug?' ) ));
        $q.spurt(($line('Write', ''), $line('', 'Done.'), $queued, $line('', 'This.')).join("\n") ~ "\n");
        nok claude-turn-may-have-changed($q.Str), 'a queued prompt after a finished turn starts a new one';
        $q.spurt(($line('Write', ''), $queued, $line('', 'This.')).join("\n") ~ "\n");
        ok claude-turn-may-have-changed($q.Str), 'one delivered between tool calls joins the work already done';
    }

    # nothing governs: stay out of the way
    my $bare = iz4-workspace(:!iz4);
    ($rc, $out, $err) = c('hook', 'claude_code', 'iz4', 'filesystem_guard', :in(encode-json(%( cwd => $bare.Str, |%write ))), :env(%( STUB_ACTION => 'block' )));
    ok $rc == 0 && $out eq '' && $err eq '', 'where no IZ4 governs, the glue does nothing at all';

    # iz4 cannot be asked.  What follows depends on what the control can do.
    # An enforcing guard STOPS the action and says enforcement could not be
    # performed, whatever the way iz4 failed.
    ($rc, $out, $err) = hook('filesystem_guard', %write, STUB_OLD => '1');
    ok $rc == 2 && $err.contains('IZ4 enforcement could not be performed') && $err.contains('cannot be driven'),
        'an iz4 that cannot be driven: the write guard stops the write and says why' or diag "$rc $out $err";
    for <exit1 garbage crash mismatch> -> $how {
        ($rc, $out, $err) = hook('filesystem_guard', %write, STUB_FAIL => $how);
        ok $rc == 2 && $err.contains('IZ4 enforcement could not be performed'), "iz4 failing ($how): the write guard stops the write" or diag "$rc $out $err";
        is $out, '', "and prints nothing that could be read as permission ($how)";
        ($rc, $out, $err) = hook('shell_guard', %( tool_name => 'Bash', tool_input => %( command => 'ls' ) ), STUB_FAIL => $how);
        is $rc, 2, "the shell guard likewise ($how)";
        ($rc, $out, $err) = hook('post_run', %( stop_hook_active => False ), STUB_FAIL => $how);
        ok $rc == 2 && $err.contains('IZ4 enforcement could not be performed'), "and the end-of-turn check is not let through as checked ($how)" or diag "$rc $out $err";
        # the context can only be told: the session starts, and the person is warned
        ($rc, $out, $err) = hook('authoritative_context', %( source => 'startup' ), STUB_FAIL => $how);
        ok $rc == 0 && $out.contains('systemMessage') && $out.contains('did NOT check'), "a context that cannot be delivered warns the person; the session is not refused ($how)" or diag "$rc $out $err";
    }
    # a check that never answers is cut off and counted as not run
    ($rc, $out, $err) = hook('filesystem_guard', %write, STUB_FAIL => 'hang', DO_321_CONTROLLER_TIMEOUT => '2');
    ok $rc == 2 && $err.contains('timed out after 2s'), 'an iz4 that hangs is cut off, and the guard stops the write' or diag "$rc $out $err";
    # the binary gone altogether, with an IZ4 still in the project
    ($rc, $out, $err) = c('hook', 'claude_code', 'iz4', 'filesystem_guard', :in(encode-json(%( cwd => $ws.Str, |%write ))), :env(%( DO_321_IZ4 => '/nonexistent/iz4' )));
    ok $rc == 2 && $err.contains('iz4 is not installed'), 'iz4 missing altogether: the guard stops the write' or diag "$rc $out $err";
    # the loop guard: a turn end already refused once is not asked again, and is not recorded as a pass
    my $log2 = temp-dir().add('hooks2.ndjson');
    ($rc, $out, $err) = c('hook', 'claude_code', 'iz4', 'post_run', :in(encode-json(%( cwd => $ws.Str, stop_hook_active => True ))),
        :env(%( DO_321_IZ4 => stub-iz4(), STUB_VERIFY => 'block', DO_321_HOOK_LOG => $log2.Str )));
    is $rc, 0, 'a turn end already refused once is let end, so a session is never trapped';
    my $rec = parse-json($log2.lines.tail);
    is $rec<result>, 'unavailable', 'and it is recorded as not asked, never as a pass';

    # An ADVISORY control lets the work through and says it was NOT checked.
    {
        my %adv = DO_321_FAKE_CONTROLS => encode-json(%( authoritative_context => 'advises', filesystem_guard => 'advises', post_run => 'advises' ));
        ($rc, $out, $err) = c('hook', 'fake', 'iz4', 'filesystem_guard', :in(encode-json(%( cwd => $ws.Str, |%write ))),
            :env(%( |%adv, DO_321_IZ4 => stub-iz4(), STUB_FAIL => 'exit1' )));
        is $rc, 0, 'where the harness can only advise, the same failure lets the write through';
        like $err, /'IZ4 did NOT check this' .* 'unchecked'/, 'with a warning that says it was not checked';
        nok ($out ~ $err).contains('enforcement could not be performed'), 'and no claim that anything was enforced';
        my %enf = DO_321_FAKE_CONTROLS => encode-json(%( authoritative_context => 'advises', filesystem_guard => 'enforces', post_run => 'enforces' ));
        ($rc, $out, $err) = c('hook', 'fake', 'iz4', 'filesystem_guard', :in(encode-json(%( cwd => $ws.Str, |%write ))),
            :env(%( |%enf, DO_321_IZ4 => stub-iz4(), STUB_FAIL => 'exit1' )));
        ok $rc == 2 && $err.contains('IZ4 enforcement could not be performed'),
            'and where it can refuse, the write is stopped even though that adapter translates nothing: the rule is the runtime\'s' or diag "$rc $out $err";
    }

    # misuse
    is c('hook', 'claude_code', 'iz4')[0], EXIT-USAGE, 'the glue needs all three names';
    is c('hook', 'nope', 'iz4', 'post_run')[0], EXIT-USAGE, 'an unknown harness is refused';
    is c('hook', 'claude_code', 'nope', 'post_run')[0], EXIT-USAGE, 'an unknown controller is refused';
    is c('hook', 'claude_code', 'iz4', 'nope')[0], EXIT-USAGE, 'an unknown control is refused';
}

# ---- the names are reserved ----------------------------------------------------------
{
    for <iz4 harness hook hooks> -> $word {
        my $bad = temp-dir().add('trust.json');
        $bad.spurt(encode-json(%( schema => 'trust-config.v1', aliases => %( $word => 'local/x' ) )));
        my ($rc, $out, $err) = c('--trust', $bad.Str, 'agents');
        ok $rc != 0 && ($out ~ $err).contains('reserved'), "an agent alias cannot shadow '$word'" or diag "$rc $out $err";
    }
}

done-testing;
