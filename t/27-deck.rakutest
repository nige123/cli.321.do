use Test;
use lib 't/lib';
use Do321Test;
use Do321::JSON;
use Do321::Protocol;
use Do321::Sys;
use Do321::RunDir;
use Do321::Term;
use Do321::Deck;
use Do321::RunWords;

if $*KERNEL.name eq 'darwin' {
    plan :skip-all('Mission Control runs on Linux for now');
    exit 0;
}

# Mission Control's screen, drawn without a terminal: the model in, the
# canvas out, at the four sizes the design was drawn at.  The words on it
# come from the runs' own files; the keys move between levels and only
# send what the person asked for.

my $home = temp-dir();
$home.chmod(0o700);
private-dir(runs-root($home));
my %me = proc-stat(my-pid());

#| A run directory written as a host would write it.  A living host is
#| this test process itself, so liveness reads it as running.
sub make-run(Str $agent, Str $request, @events, Bool :$alive = True, Str :$receipt, Str :$workspace = '/work/shop', Str :$color = '' --> RunDir) {
    my $r = run-dir(new-ulid(), $home);
    private-dir($r.dir);
    private-dir($r.inbox);
    write-atomic($r.run-file, encode-json({ schema => SCHEMA-RUN, runId => $r.id, request => $request, workspace => $workspace,
        agent => { name => $agent.lc, displayName => $agent, byline => 'builds, and brings the proof', color => $color },
        launchedAt => DateTime.now.utc.earlier(:minutes(12)).Str }));
    write-atomic($r.host-file, encode-json({ pid => my-pid(), startTicks => $alive ?? %me<start> !! 1, bootId => boot-id() }));
    my $log = EventLog.new(:path($r.events-file));
    $log.append(.[0], .[1], .[2]) for @events;
    $log.close;
    with $receipt { $r.receipt-file.spurt(encode-json(%( status => $_, summary => "the work is done" ))); $r.receipt-file.chmod(0o600) }
    sleep 0.002;
    $r;
}

my $a = make-run('Bea', 'add passkey sign-in to the shop', :color<#c0552e>, [
    ['host', 'host_started', { request => 'add passkey sign-in to the shop' }],
    ['run', 'attempt_started', { attempt => 1 }],
    ['run', 'tool_call', { tool => 'Bash', target => 'prove t/30-auth.t' }],
    ['run', 'progress', { text => 'Two tests fail on the challenge encoding. Fixing that now.' }],
    ['host', 'directive_delivered', { directiveId => 'D1', kind => 'steer', text => 'use base64url, not base64' }],
    ['run', 'directive_received', { directiveId => 'D1', kind => 'steer' }],
    ['run', 'progress', { instruction => 'use base64url, not base64', directiveId => 'D1' }],
]);
my $b = make-run('Bea', 'fix flaky t/19-status', [['host', 'host_started', { request => 'fix flaky t/19-status' }], ['run', 'attempt_started', { attempt => 1 }]]);
my $c = make-run('Ada', 'plan the release', [['host', 'host_started', { request => 'plan the release' }],], :!alive);
my $d = make-run('Ada', 'status the release', [['host', 'host_started', { request => 'status the release' }],
    ['host', 'receipt', { status => 'completed', summary => 'the work is done' }]], :receipt<completed>);

my $m = Model.new(:$home);
$m.scan;
$m.sel = $m.crew.first({ .id eq $a.id }, :k);

subtest 'the deck at 120x36' => {
    my $t = render($m, 36, 120).text;
    my @l = $t.lines;
    ok @l[0].starts-with('❮▣❯ 321 MISSION CONTROL'), 'the title is the first line' or diag @l[0];
    ok @l[0].contains('2 active'), 'the active runs are counted';
    ok @l[0].contains('1 needs a look'), 'a lost run needs a look';
    ok $t.contains("▸ {$a.short}"), 'the selected run has the marker';
    ok $t.contains('add passkey sign-in to the shop'), 'the mission is the request';
    ok $t.contains('running a tool') || $t.contains('writing'), 'a running run says what it is doing';
    ok $t.lines.first(*.contains($c.short)).contains('lost'), 'a run whose host is not that process is lost, never running';
    ok $t.lines.first(*.contains($d.short)).contains('done'), 'a run with a receipt says how it ended';
    ok $t.contains('Bea, builds, and brings the proof'), 'the byline names who is answering';
    ok $t.contains('use base64url, not base64') && $t.contains('✓ taken'), 'the steer is shown taken';
    ok $t.contains("to BEA {$a.short} ❯"), 'the input line says who it goes to';
    # the agent's name wears its own accent, as 123 shows the same agent
    my $cv = render($m, 36, 120);
    my $bea = $cv.grid.map({ .grep({ .[0] eq 'B' && .[1].contains('#c0552e') }).elems }).sum;
    ok $bea >= 3, 'Bea\'s name wears her accent in the deck, the header and the conversation' or diag $bea;
    is $m.crew.first({ .id eq $c.id }).accent, 'wait', 'an agent without one gets the amber 123 falls back to';
    my $arrow = render($m, 36, 120).grid[36 - 2].first({ .[0] eq '❯' });
    is $arrow[1], 'now', 'and its arrow wears the focus blue, like the cursor after it';
    ok @l[*-1].contains('Enter send') && @l[*-1].contains('Esc keys') && @l[*-1].contains('/start'), 'the footer teaches the keys and the words';
    nok $t.contains('Ctrl') || $t.contains('^'), 'and no control key';
    nok $t.contains('stuck'), 'nothing is called stuck';
}

subtest 'the four sizes' => {
    for (160, 48), (120, 36), (80, 24) -> ($cols, $rows) {
        my $cv = render($m, $rows, $cols);
        ok $cv.line(0).contains('MISSION CONTROL'), "{$cols}x{$rows}: the deck layout";
        ok (^$rows).map({ text-width($cv.line($_)) }).max <= $cols, "{$cols}x{$rows}: nothing runs off the edge";
    }
    my $cv = render($m, 20, 60);
    ok $cv.line(0).contains("▸{$a.short}"), '60x20: the crew folds into one strip';
    ok $cv.text.contains('use base64url'), '60x20: the conversation keeps the rest';
    ok (^20).map({ text-width($cv.line($_)) }).max <= 60, '60x20: nothing runs off the edge';
}

subtest 'keys: levels, the input line and confirmation' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $b.id }, :k);
    handle-key($mm, Key.new(:name<char>, :text($_))) for 'try again'.comb;
    handle-key($mm, Key.new(:name<enter>));
    my @t = take-inbox($b);
    is @t[0]<directive><kind>, 'steer', 'Enter sends a steer to the selected run';
    is @t[0]<directive><text>, 'try again', 'with the words typed';
    is $mm.input, '', 'and clears the line';

    handle-key($mm, Key.new(:name<esc>));
    is $mm.mode, 'nav', 'Esc leaves the input line for navigation';
    handle-key($mm, Key.new(:name<char>, :text<s>));
    is $mm.mode, 'confirm', 's asks before stopping';
    ok $mm.confirm[0].contains('keep'), 'and says the others keep running' or diag $mm.confirm[0];
    handle-key($mm, Key.new(:name<char>, :text<n>));
    is take-inbox($b).elems, 0, 'any key but y sends nothing';
    handle-key($mm, Key.new(:name<char>, :text<s>));
    handle-key($mm, Key.new(:name<char>, :text<y>));
    is take-inbox($b)[0]<directive><kind>, 'stop', 'y sends the stop';

    $mm.sel = $mm.crew.first({ .id eq $d.id }, :k);
    $mm.mode = 'input';
    handle-key($mm, Key.new(:name<char>, :text<x>));
    handle-key($mm, Key.new(:name<enter>));
    ok $mm.flash.starts-with('not asked:'), 'words to an ended run begin its agent\'s next run, or say why not' or diag $mm.flash;
    is take-inbox($d).elems, 0, 'nothing reached its inbox';

    $mm.sel = $mm.crew.first({ .id eq $c.id }, :k);
    $mm.mode = 'input'; $mm.input = 'x'; $mm.cursor = 1;
    handle-key($mm, Key.new(:name<enter>));
    ok $mm.flash.contains('lost') && $mm.flash.contains('/restart'), 'a lost run has no receipt to go on from; /restart is the way';
    is take-inbox($c).elems, 0, 'and nothing reached its inbox';

    $mm.mode = 'confirm';
    $mm.confirm = ['Run ADA J55\'s request again? It changed 2 files and ran 4 tools; the new run has its own budget, and no approval carries over.', 'restart-now'];
    my $cv = render($mm, 30, 100);
    my $text = $cv.text;
    ok $text.contains('Run ADA') && $text.contains('carries over.'), 'a question longer than its row begins on the rule above and ends on the row' or diag $text;
    $cv = render($mm, 30, 80);
    ok $cv.text.contains('carries over.'), 'even at the deck\'s narrowest';
    $mm.mode = 'input'; $mm.input = ''; $mm.cursor = 0;

    $mm.sel = $mm.crew.first({ .id eq $c.id }, :k);
    ok actions-for($mm).first(*<key> eq 'force'), 'a lost run offers Force stop';
    nok actions-for($mm).first(*<key> eq 'hold'), 'and not Hold';
    handle-key($mm, Key.new(:name<ctrl-d>));
    nok $mm.quit, 'a control key is not a command';
    $mm.mode = 'nav';
    handle-key($mm, Key.new(:name<char>, :text<q>));
    ok $mm.quit, 'q leaves; the runs keep going';
}

subtest 'a message too long for its row is never cut' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.tell("not started: {$*HOME}/.321 is not safe to use: others may write to it; chmod go-w {$*HOME}/.321 makes it yours alone");
    ok $mm.flash.contains('~/.321'), 'the home directory is said the short way';
    my $t = render($mm, 24, 60).text;
    ok $t.contains('makes it yours alone'), 'the end of it, which says what to do, is on the screen' or diag $t;
    ok $t.contains('not started'), 'and so is the start';
}

subtest 'words on the input line: the same words as at the shell' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $b.id }, :k);
    my sub say-line(Str $t) { handle-key($mm, Key.new(:name<char>, :text($_))) for $t.comb }
    say-line('/st');
    ok render($mm, 36, 120).text.contains('/start  /steer  /stop'), 'a word begun lists what it could be';
    handle-key($mm, Key.new(:name<tab>));
    is $mm.input, '/st', 'Tab goes as far as they agree';
    say-line('o');
    handle-key($mm, Key.new(:name<tab>));
    is $mm.input, '/stop ', 'and finishes the one it can only be';
    ok render($mm, 36, 120).text.contains('ask a run to stop'), 'whose use is shown before it is sent';
    handle-key($mm, Key.new(:name<enter>));
    is $mm.mode, 'confirm', '/stop asks first, as s does';
    handle-key($mm, Key.new(:name<char>, :text<n>));
    is take-inbox($b).elems, 0, 'and a no sends nothing';

    $mm.mode = 'input';
    say-line('/hold');
    handle-key($mm, Key.new(:name<enter>));
    is take-inbox($b)[0]<directive><kind>, 'hold', '/hold holds the run you are on';
    is $mm.input, '', 'and clears the line';

    say-line('//look at /tmp');
    handle-key($mm, Key.new(:name<enter>));
    is take-inbox($b)[0]<directive><text>, '/look at /tmp', 'two slashes send one, as words';

    say-line('/frobnicate');
    handle-key($mm, Key.new(:name<enter>));
    ok $mm.flash.contains('not a word here'), 'a word it does not know is said so' or diag $mm.flash;
    is take-inbox($b).elems, 0, 'and nothing is sent';
    $mm.input = ''; $mm.cursor = 0;

    say-line("/stop {$d.id.substr(*-3).lc}");
    handle-key($mm, Key.new(:name<enter>));
    is $mm.selected.id, $d.id, 'a run named by its last three characters is chosen';
    ok $mm.flash.contains('already ended'), 'and an ended one is not stopped again' or diag $mm.flash;

    say-line('/view needs');
    handle-key($mm, Key.new(:name<enter>));
    is $mm.filter, 'needs', '/view chooses what the deck shows';
    $mm.filter = 'all';

    say-line('/quit');
    handle-key($mm, Key.new(:name<enter>));
    ok $mm.quit, '/quit leaves';
}

subtest 'from 150 columns: a rail, the conversation and the evidence' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $a.id }, :k);
    my $cv = render($mm, 40, 160);
    my $t = $cv.text;
    ok $t.contains('EVIDENCE'), 'the evidence pane is there';
    ok $t.lines.first({ .contains('tools') && .contains('1 call') }), 'with what the log says';
    ok $t.lines.first({ .contains('host') && .contains("pid {my-pid()}") }), 'and who the host is';
    ok $t.lines.first({ .starts-with("▸ {$a.short}") }), 'the crew is a rail, the selected run marked';
    ok $t.contains('Two tests fail on the challenge'), 'the conversation is in the middle';
    ok (^40).map({ text-width($cv.line($_)) }).max <= 160, 'nothing runs off the edge';
}

subtest 'filters and what is new' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $a.id }, :k);
    $mm.mode = 'nav';
    handle-key($mm, Key.new(:name<char>, :text<v>));
    is $mm.filter, 'active', 'v shows the active runs';
    ok $mm.visible.map(*.id).sort eqv ($a.id, $b.id).sort, 'only those';
    is $mm.selected.id, $a.id, 'the selection stays where it was';
    ok render($mm, 36, 120).line(0).contains('showing active runs'), 'the title says what is shown';
    handle-key($mm, Key.new(:name<char>, :text<v>));
    is $mm.visible.map(*.id).List, ($c.id,), 'then the runs that need you: the lost one';
    handle-key($mm, Key.new(:name<char>, :text<v>));
    is $mm.filter, 'all', 'then every run again';

    my $log = EventLog.new(:path($b.events-file));
    $log.append('run', 'progress', { text => 'Found it: the clock.' });
    $log.close;
    .refresh for $mm.crew;
    ok render($mm, 36, 120).text.lines.first(*.contains($b.short)).contains('1 new'), 'a run that said something since is marked new';
    $mm.sel = $mm.crew.first({ .id eq $b.id }, :k);
    render($mm, 36, 120);
    is $mm.selected.unread, 0, 'and is not, once looked at';
}

subtest 'find in the conversation' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $a.id }, :k);
    handle-key($mm, Key.new(:name<char>, :text($_))) for '/find CHALLENGE'.comb;
    handle-key($mm, Key.new(:name<enter>));
    is $mm.mode, 'find', '/find finds';
    ok $mm.flash.starts-with('match 1 of 1'), 'the match is counted, case aside' or diag $mm.flash;
    my $cv = render($mm, 36, 120);
    my $row = (^36).first({ $cv.line($_).contains('Two tests fail') });
    ok $cv.grid[$row][20][1].contains('sel'), 'the line found is marked';
    handle-key($mm, Key.new(:name<esc>));
    is ($mm.mode, $mm.input), ('input', ''), 'Esc goes back to the input line';
}

subtest 'what the screen says without evidence' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    my $cr = $mm.crew.first({ .id eq $a.id });
    write-atomic($a.status-file, encode-json({ heartbeatAt => DateTime.now.utc.earlier(:minutes(1)).Str }));
    $cr.checked = 0e0;
    $cr.refresh;
    ok crew-line($cr, 1)[1].starts-with('no heartbeat for'), 'a host that stopped beating is said so';
    $a.status-file.unlink;

    $mm.sel = $mm.crew.first({ .id eq $b.id }, :k);
    handle-key($mm, Key.new(:name<char>, :text($_))) for 'look at the clock'.comb;
    handle-key($mm, Key.new(:name<enter>));
    my $sel = $mm.selected;
    ok comms-lines($sel, 100).tail.map(*[0]).join.contains('· sending'), 'a steer is echoed at once';
    $sel.sent{$sel.sent.keys[0]}[1] -= 10;
    ok comms-lines($sel, 100).tail.map(*[0]).join.contains('unconfirmed'), 'and called unconfirmed when no answer comes';
    take-inbox($b);

    $mm.sel = $mm.crew.first({ .id eq $d.id }, :k);
    ok actions-for($mm).first(*<key> eq 'restart'), 'an ended run can be run again';
    do-action($mm, 'restart');
    ok $mm.confirm[0].contains('own budget') && $mm.confirm[0].contains('no approval carries over'), 'after a question that says what that means';
}

subtest 'what a run is on, from its own events' => {
    my $h = make-run('Bea', 'tidy the totals', [['host', 'host_started', { request => 'tidy the totals' }],
        ['run', 'adapter_selected', { adapter => 'claude_code', model => 'haiku', effort => 'low', profile => 'economy' }],
        ['run', 'attempt_started', { attempt => 1, model => 'haiku', effort => 'low' }]]);
    my $bare = make-run('Bea', 'tidy the tests', [['host', 'host_started', { request => 'tidy the tests' }], ['run', 'adapter_selected', { adapter => 'codex' }]]);
    my $mm = Model.new(:$home);
    $mm.scan;
    my $c = $mm.crew.first({ .id eq $h.id });
    is evidence-rows($c).first({ .[0] eq 'ran on' })[1], 'haiku, low effort (economy)', 'the evidence names the model, effort and profile';
    nok evidence-rows($mm.crew.first({ .id eq $bare.id })).first({ .[0] eq 'ran on' }), 'and says nothing where the runtime named none';
}

subtest 'the agent first, the harness beside it' => {
    my $h1 = make-run('Bea', 'add a coupon field', [['host', 'host_started', { request => 'add a coupon field' }], ['run', 'adapter_selected', { adapter => 'claude_code' }]]);
    my $h2 = make-run('Bea', 'add a coupon field', [['host', 'host_started', { request => 'add a coupon field' }], ['run', 'adapter_selected', { adapter => 'codex' }]]);
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $h1.id }, :k);
    my $t = render($mm, 36, 120).text;
    my $r1 = $t.lines.first(*.contains($h1.short));
    my $r2 = $t.lines.first(*.contains($h2.short));
    ok $r1.contains('BEA') && $r1.contains('Claude Code'), 'one row: Bea, on Claude Code' or diag $r1;
    ok $r2.contains('BEA') && $r2.contains('Codex'), 'the other: Bea, on Codex' or diag $r2;
    ok $r1.index('BEA') < $r1.index('Claude Code'), 'the agent leads, the harness follows';
    ok $t.lines.first({ .contains('CREW') && .contains('HARNESS') && .contains('MISSION') }), 'and the column is headed HARNESS, so the engine is never read as the model';
    ok $t.contains("{$h1.short} · on Claude Code"), 'the selected run says which engine it is on';
    $mm.sel = $mm.crew.first({ .id eq $h2.id }, :k);
    my $w = render($mm, 40, 160).text;
    ok $w.contains('on Codex'), 'from 150 columns the conversation is headed with the engine too';
    ok $w.lines.first({ .contains('cannot') && .contains('tool_allowlist') }), 'and the evidence says what that engine cannot do';
    ok $w.lines.first({ .contains('Codex · add a coupon') }), 'the rail names each run\'s engine';
}

subtest 'the arrows stop at the ends of the crew; Tab cycles' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    my $n = $mm.visible.elems;
    ok $n >= 2, "$n runs to move between";
    $mm.mode = 'nav';
    $mm.sel = $n - 1;
    handle-key($mm, Key.new(:name<down>));
    is $mm.sel, $n - 1, 'down on the last run stays on it';
    $mm.sel = 0;
    handle-key($mm, Key.new(:name<up>));
    is $mm.sel, 0, 'up on the first stays on it';
    $mm.mode = 'input';
    $mm.sel = $n - 1;
    handle-key($mm, Key.new(:name<tab>));
    is $mm.sel, 0, 'Tab from the last run comes round to the first';
    handle-key($mm, Key.new(:name<shift-tab>));
    is $mm.sel, $n - 1, 'and Shift-Tab goes back round';
}

subtest 'decoding keys' => {
    my ($k, $rest) = decode-keys(Buf.new("\e[A\e[B\e[5~a\r".encode.list));
    is $k.map(*.Str).join(' '), '<up> <down> <pgup> a <enter>', 'arrows, page keys, a character and Enter';
    ($k, $rest) = decode-keys(Buf.new("\e[200~line one\nline two\e[201~".encode.list));
    is $k[0].name, 'paste', 'a paste arrives whole';
    is $k[0].text, "line one\nline two", 'newlines and all, never run as keys';
    my $snow = '漢'.encode;
    ($k, $rest) = decode-keys(Buf.new($snow.subbuf(0, 2).list));
    is $k.elems, 0, 'half a character waits';
    is $rest.elems, 2, 'and is kept for the next read';
    ($k, $rest) = decode-keys(Buf.new(0x04));
    is $k[0].name, 'ctrl-d', 'control keys have names';
}

subtest 'widths' => {
    is text-width('漢字'), 4, 'wide characters take two columns';
    is fit('add passkey sign-in to the shop', 10), 'add passk…', 'cut with an ellipsis';
    is text-width(pad('漢字abc', 6)), 6, 'pad counts columns, not characters';
}

subtest 'the evidence says what iz4 last found, in its words' => {
    my $ws = temp-dir();
    $ws.add('.git').add('iz4').mkdir;
    $ws.add('.git').add('iz4').add('last.json').spurt(encode-json(%( schema => 'iz4-last/1', result => 'pass',
        line => '◈ IZ4: all held: the foundation word for word and all 3 invariants by their tests' )));
    my $r = make-run('Iris', 'tidy the readme', [['run', 'attempt_started', { attempt => 1 }],], :workspace($ws.Str));
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $r.id }, :k);
    my $t = render($mm, 40, 160).text;
    ok $t.lines.first({ .contains('iz4') && .contains('all held: the foundation') }), 'iz4\'s last line is in the evidence, its verdict first' or diag $t;
    $mm.sel = $mm.crew.first({ .id eq $a.id }, :k);
    nok render($mm, 40, 160).text.lines.first({ .contains('all held') }), 'and only for the run whose workspace it is';
}

subtest 'where the work came from, the shell words, and still marks' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    my $cr = $mm.crew.first({ .id eq $b.id });
    is $cr.origin, '', 'a run started here names no origin';
    ok evidence-rows($cr).first({ .[0] eq 'from' })[1].starts-with('started here'), 'and the evidence says it was started here';

    # a package something else issued: its issuer and references, as given
    my %run = parse-json($b.run-file.slurp);
    %run<issuer> = %( kind => '123', id => 'api.123.do', url => 'https://api.123.do' );
    %run<refs> = [ %( kind => 'track', id => 'shop.example' ), %( kind => 'step', id => '200' ), %( kind => 'step' ), ];
    my $kept = $b.run-file.slurp;
    write-atomic($b.run-file, encode-json(%run));
    my $m2 = Model.new(:$home);
    $m2.scan;
    my $c2 = $m2.crew.first({ .id eq $b.id });
    is $c2.origin, 'api.123.do: track shop.example, step 200', 'an issued run says who issued it and for what, a half-said reference left out';
    is evidence-rows($c2).first({ .[0] eq 'from' })[1], $c2.origin, 'in the evidence';
    $m2.sel = $m2.crew.first({ .id eq $b.id }, :k);
    ok render($m2, 40, 160).text.contains('api.123.do: track'), 'on the wide screen';
    ok render($m2, 36, 120).text.contains('from api.123.do: track shop.example'), 'and beside the request at an ordinary width';
    write-atomic($b.run-file, $kept);

    # every hint is a line the shell's own parser takes
    for <stop hold resume> -> $verb {
        my $hint = cli-hint($verb, $cr);
        ok $hint.starts-with(" · CLI: 321 $verb {$cr.short}"), "$verb says its shell words";
        my @w = $hint.subst(' · CLI: 321 ', '').words;
        nok parse-run-words(@w[0], @w[1..*])<error>, "and the shell takes them: {@w.join(' ')}";
    }
    my @s = cli-hint('steer', $cr, 'look again').subst(' · CLI: 321 ', '').words;
    nok parse-run-words(@s[0], @s[1..*])<error>, 'a steer too';
    is cli-hint('find', $cr), '', 'a word only the screen has gets no shell hint';
    { temp %*ENV<DO_321_HINTS> = '0'; is cli-hint('stop', $cr), '', 'DO_321_HINTS=0 leaves the hints out'; }

    # still marks
    my @marks = (^8).map({ crew-line($cr, $_)[0] }).unique;
    is (^4).map({ track-mark($mm.crew.first({ .id eq $a.id }), $_)[0] }), <▣ ▢ ▣ ▢>, 'a job being worked on throbs, an even pulse';
    is (^4).map({ track-mark($mm.crew.first({ .id eq $d.id }), $_)[0] }).unique, ('■',), 'and nothing else moves';
    { temp %*ENV<DO_321_MOTION> = '0';
      is (^8).map({ crew-line($cr, $_)[0] }).unique.elems, 1, 'DO_321_MOTION=0 keeps the mark still'; }
}

subtest 'the input area grows with what is typed, and an editor takes a long thought' => {
    my %l = input-layout('hello', 5, 20, 8);
    is (%l<lines>.elems, %l<row>, %l<col>), (1, 0, 5), 'a short line is one row, the cursor at its end';
    %l = input-layout('a' x 45, 45, 20, 8);
    is (%l<lines>.elems, %l<row>, %l<col>), (3, 2, 5), 'a long one wraps onto as many rows as it needs';
    %l = input-layout("one\ntwo", 4, 20, 8);
    is (%l<lines>.join('|'), %l<row>, %l<col>), ('one|two', 1, 0), 'a line the person broke is a row of its own';
    %l = input-layout('a' x 200, 200, 20, 4);
    is (%l<lines>.elems, %l<row>, %l<above>), (4, 3, 7), 'past the most rows it scrolls with the cursor and counts what is above';
    %l = input-layout('a' x 200, 0, 20, 4);
    is (%l<row>, %l<above>), (0, 0), 'and back at the start it shows the start';
    is input-layout('日本語', 3, 4, 8)<lines>.join('|'), '日本|語', 'rows are measured in columns, not characters';

    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.sel = $mm.crew.first({ .id eq $b.id }, :k);
    my $one = render($mm, 36, 100);
    my $rule1 = (^36).first({ $one.line($_).starts-with('───') }, :end);
    $mm.input = 'please look at the checkout again, ' x 8;
    $mm.cursor = $mm.input.chars;
    my $many = render($mm, 36, 100);
    my $rule2 = (^36).first({ $many.line($_).starts-with('───') }, :end);
    ok $rule2 < $rule1, 'the area takes more rows as the text grows';
    ok $many.text.contains('look at the checkout again') && $many.line(35).contains('Enter send'), 'the text is whole and the hint stays below it';
    my ($cr, $cc) = cursor-at($mm, 36, 100);
    is $cr, 34, 'the cursor is on the last row of the text';
    $mm.input = 'x' x 5000; $mm.cursor = 5000;
    my $big = render($mm, 36, 100);
    my $rule3 = (^36).first({ $big.line($_).starts-with('───') || $big.line($_).contains('above') }, :end);
    is 36 - 2 - $rule3, input-max(36), 'and never more than its share of the screen';
    ok $big.text.contains('above'), 'saying how much is above';

    # Ctrl-G asks for the editor; what the editor leaves is the draft, unsent
    $mm.input = 'first thought'; $mm.cursor = 5;
    handle-key($mm, Key.new(:name<ctrl-g>));
    ok $mm.want-editor, 'Ctrl-G asks for the editor';
    $mm.want-editor = False;
    run-line($mm, '/edit a start');
    ok $mm.want-editor && $mm.input eq 'a start', '/edit does too, opening on the words after it';
    $mm.input = 'first thought';
    my $seen;
    my $inbox-before = $b.inbox.dir.grep(*.f).elems;
    my $why = edit-draft($mm, -> $f { $seen = $f.slurp; is $f.mode, '0600', 'the draft file is private'; $f.spurt("a longer thought\nover two lines\n\n") });
    nok $why.defined, 'the editor finished';
    is $seen, 'first thought', 'the editor opens on what was typed';
    is $mm.input, "a longer thought\nover two lines", 'what it leaves is the input, its trailing blank lines dropped';
    is $mm.cursor, $mm.input.chars, 'the cursor at its end';
    is $b.inbox.dir.grep(*.f).elems, $inbox-before, 'nothing is sent until Enter';
    nok $mm.draft-file.e, 'the draft file is gone';
    is edit-draft($mm, -> $f { die 'vi ended 1' }), 'vi ended 1', 'an editor that fails is said';
    { temp %*ENV<VISUAL> = ''; temp %*ENV<EDITOR> = 'nano -w'; is editor-command(), 'nano -w', 'the editor is the one the person named, flags and all'; }
    { temp %*ENV<VISUAL> = ''; temp %*ENV<EDITOR> = ''; is editor-command(), 'vi', 'else vi'; }
}

subtest 'a trackline for each agent' => {
    my $mm = Model.new(:$home);
    $mm.scan;
    set-layout($mm, 'lines');
    is $mm.visible.map(*.name).squish.elems, $mm.visible.map(*.name).unique.elems, 'the runs are walked agent by agent';
    $mm.sel = $mm.visible.first({ .id eq $b.id }, :k);
    my $cv = render($mm, 36, 120);
    my @t = $cv.text.lines;
    my $head = @t.first(*.starts-with('  CREW'));
    my sub row-of(Str $n) { @t.first({ .starts-with("  $n") && .contains('│') }) }
    my ($bea, $ada, $iris) = row-of('BEA'), row-of('ADA'), row-of('IRIS');
    ok $bea.defined && $ada.defined && $iris.defined, 'each agent has a row of its own';
    is @t.grep({ .starts-with('  BEA') }).elems, 1, 'one row, however much it has in hand';
    my @bars = $bea.indices('│');
    is @bars.elems, 2, 'now is between two bars';
    ok $bea.substr(@bars[0], @bars[1] - @bars[0]).comb.grep({ $_ eq '▣' | '▢' }).elems >= 2, 'everything in hand stands side by side between them';
    is ($ada.indices('│'), $iris.indices('│')), (@bars, @bars), 'the bars line up down the screen';
    is $head.index('NOW') + 1, (@bars[0] + @bars[1]) div 2, 'the word NOW is centred over them';
    ok abs((@bars[0] + @bars[1]) div 2 - 60) <= 1, 'and now is the middle of the screen' or diag @bars.raku;
    my @wb = render($mm, 28, 200).text.lines.first({ .starts-with('  BEA') && .contains('│') }).indices('│');
    ok abs((@wb[0] + @wb[1]) div 2 - 100) <= 1, 'at any width' or diag @wb.raku;
    my @hd = $cv.grid[@t.first({ $_ eq $head }, :k)];
    is (@hd[$head.index('DONE')][1], @hd[$head.index('NOW')][1], @hd[$head.index('NEXT')][1]), <ok now wait>, 'each heading wears its zone\'s colour';
    ok $bea ~~ / <[▣▢■▪⊠◧]> \s\s+ '❮'? <[▣▢■▪⊠◧]> /, 'with room between the marks';
    ok $head.index('DONE') < @bars[0] < @bars[1] < $head.index('NEXT'), 'between DONE and NEXT';
    is $cv.grid[@t.first({ $_ eq $bea }, :k)][@bars[0]][1], 'now', 'the bars wear the focus blue';
    ok $ada.contains('■') && $ada.contains('⊠'), 'what is done and what did not happen have marks of their own';
    ok $ada.index('■') < @bars[0], 'to the left of now';
    ok $ada.substr(@bars[0], @bars[1] - @bars[0]) ~~ / '·' / && !($ada ~~ / <[▣▢]> /), 'an agent with nothing in hand has a still point between its bars';
    nok $bea.contains('fix flaky') || $bea.contains('─'), 'a row is marks alone: no words, no rules';
    is $cv.text.lines[2..*].join.comb('❮').elems, 1, 'the cursor is 321\'s own mark closed on one job, and is nowhere else';
    ok $bea ~~ / '❮' <[▣▢]> '❯' /, 'on the row';
    my $dl = @t.first({ .contains("Bea {$b.short}") }, :k);
    ok @t[$dl].contains("Bea {$b.short}") && @t[$dl].contains('fix flaky t/19-status'), 'the detail says what the job under the cursor is' or diag @t[$dl];
    ok @t[$dl + 1].trim ne '' && !@t[$dl + 1].contains('fix flaky'), 'and under it how it stands' or diag @t[$dl + 1];
    ok @t.first({ $_ ne $head && .contains(TRACK-LEGEND) }), 'a tall screen has the key to the shapes on a row of its own';
    my @wide = render($mm, 28, 200).text.lines;
    ok @wide.first({ !.starts-with('  CREW') && .contains(TRACK-LEGEND) }), 'a wide, short one has it too, under the lines';
    is @wide.grep(*.contains(TRACK-LEGEND)).elems, 1, 'once';
    # a large screen: a panel at the right, for the shapes and the keys
    my $big = render($mm, 36, 180);
    my @big = $big.text.lines;
    my $pc = @big.first(*.contains('SHAPES')).index('SHAPES');
    my @bb = @big.first({ .starts-with('  BEA') && .contains('│') }).substr(0, $pc).indices('│');
    ok abs((@bb[0] + @bb[1]) div 2 - 90) <= 1, 'now is still the middle of the whole screen, the panel beside it' or diag @bb.raku;
    ok $pc > 180 - PANEL-WIDTH - 2, 'a large screen has a panel at the right' or diag @big[2];
    nok $big.text.contains(TRACK-LEGEND), 'the key to the shapes is in it, a shape a row, and nowhere else';
    is @big.grep({ .chars > $pc && .substr($pc) ~~ / ^ <[■▪⊟⊠◧▣◫□]> \s+ \w / }).elems, 8, 'every shape and its word';
    my $wr = @big.first({ .chars > $pc && .substr($pc).starts-with('▣') }, :k);
    is $big.grid[$wr][$pc][1], 'bold', 'the shape of the job under the cursor is picked out';
    my $tj = @big.first({ .chars > $pc && .substr($pc).starts-with('THIS JOB') }, :k);
    is (@big[$tj + 1].substr($pc).trim, @big[$tj + 2].substr($pc).trim), </hold /stop>, 'under it, what can be done to that job, as words at the prompt';
    nok @big.first({ .contains("Bea {$b.short}") }).contains('/hold'), 'so the title no longer carries them';
    ok @big.first({ .chars > $pc && .substr($pc).starts-with('MOVE') }), 'and how to move';
    $mm.mode = 'nav';
    my @bn = render($mm, 36, 180).text.lines;
    ok @bn[$tj + 1].substr($pc) ~~ / ^ 'h' \s+ 'hold' / && @bn[$tj + 2].substr($pc) ~~ / ^ 's' \s+ 'stop' /, 'on the lines they are keys' or diag @bn[$tj + 1];
    $mm.mode = 'input';
    nok render($mm, 28, 180).text.contains('SHAPES') || render($mm, 36, 130).text.contains('SHAPES'), 'a screen that is not large keeps its width for the work';
    nok render($mm, 24, 100).text.contains('■ done'), 'a small screen keeps its rows for the work';
    ok @t[$dl].ends-with('/hold   /stop'), 'beside the title, what can be done to that job, as words at the prompt' or diag @t[$dl];
    ok @t[$dl + 1] ~~ / \d+ ':' \d\d / , 'with the time it has taken' or diag @t[$dl + 1];
    my $paid = make-run('Iris', 'cost the release', [['host', 'host_started', { request => 'cost the release' }], ['run', 'attempt_started', { attempt => 1 }],
        ['run', 'adapter_selected', { adapter => 'claude_code' }], ['run', 'cost', { usd => 1.25, basis => 'reported' }]]);
    my $mp = Model.new(:$home);
    $mp.scan;
    set-layout($mp, 'lines');
    $mp.sel = $mp.visible.first({ .id eq $paid.id }, :k);
    my $pl = render($mp, 36, 120).text.lines.first({ .contains('on Claude Code') });
    ok $pl.defined, 'the harness it is on' or diag render($mp, 36, 120).text;
    ok $pl.contains('$1.25'), 'and what it has cost, where the harness reported it' or diag $pl;
    nok $cv.text.contains('EVIDENCE'), 'the evidence is out of the way: the conversation has the width';
    $mm.mode = 'nav';
    handle-key($mm, Key.new(:name<char>, :text<e>));
    ok render($mm, 36, 120).text.contains('EVIDENCE'), 'e shows it, for a person who wants to look';
    run-line($mm, '/view evidence');
    nok render($mm, 36, 120).text.contains('EVIDENCE'), 'and /view evidence, the same as a word, puts it away';
    $mm.mode = 'input';
    is track-mark($mm.crew.first({ .id eq $d.id }), 1)[1], 'ok', 'what is done is green';
    is track-mark($mm.crew.first({ .id eq $a.id }), 1)[1], 'now', 'what is in hand is blue, whichever agent has it';
    is track-mark($mm.crew.first({ .id eq $c.id }), 1)[1], 'bad', 'what did not happen is red, never read as done';
    ok $cv.grid[@t.first({ $_ eq $bea }, :k)][2][1].contains('#c0552e'), 'an agent\'s own colour is on its name';

    # still marks, and a run that waits its turn
    $b.queued-file.spurt('');
    my $m2 = Model.new(:$home);
    $m2.scan;
    set-layout($m2, 'lines');
    my $q = $m2.crew.first({ .id eq $b.id });
    is $q.phase, 'queued', 'a run whose host waits its turn is queued';
    is track-mark($q, 1), ('□', 'wait', 'next'), 'an open square, orange, to the right of now';
    ok $q.active, 'it counts as active';
    ok actions-for((do { $m2.sel = $m2.visible.first({ .id eq $b.id }, :k); $m2 })).first(*<key> eq 'go'), 'and can be let go now';
    is crew-line($q, 1)[0], '▫', 'in the table too';
    $b.queued-file.unlink;
    is (^4).map({ track-mark($mm.crew.first({ .id eq $a.id }), $_)[0] }), <▣ ▢ ▣ ▢>, 'a job being worked on throbs, an even pulse';
    is (^4).map({ track-mark($mm.crew.first({ .id eq $d.id }), $_)[0] }).unique, ('■',), 'and nothing else moves';
    { temp %*ENV<DO_321_MOTION> = '0';
      my $w = $mm.crew.first({ .id eq $a.id });
      is (^8).map({ track-mark($w, $_)[0] }).unique, ('▣',), 'DO_321_MOTION=0 keeps the now square still'; }

    # a run that waits on a person is still in hand, until it is answered
    my $w = make-run('Ada', 'migrate the orders table', [['host', 'host_started', { request => 'migrate the orders table' }],
        ['host', 'receipt', { status => 'blocked', summary => 'which database?' }]], :receipt<blocked>);
    my $m3 = Model.new(:$home);
    $m3.scan;
    set-layout($m3, 'lines');
    is $m3.zones{$w.id}, 'now', 'a run that waits on you is in NOW: it is your move';
    my $wl = render($m3, 36, 120).text.lines.first({ .starts-with('  ADA') && .contains('│') });
    ok $wl.substr($wl.index('│')).contains('◧'), 'between the bars' or diag $wl;
    my $ans = make-run('Ada', 'the staging one', [['host', 'host_started', { request => 'the staging one' }], ['run', 'attempt_started', { attempt => 1 }]]);
    my %r = parse-json($ans.run-file.slurp);
    %r<follows> = { runId => $w.id };
    write-atomic($ans.run-file, encode-json(%r));
    my $m4 = Model.new(:$home);
    $m4.scan;
    set-layout($m4, 'lines');
    is $m4.zones{$w.id}, 'done', 'once a run goes on from it, it is answered, and done';
    is $m4.zones{$ans.id}, 'now', 'and the run that went on is in hand';
    my $c4 = render($m4, 36, 120);
    my $r4 = (^36).first({ $c4.line($_).starts-with('  ADA') });
    my @amber = $c4.grid[$r4].grep({ .[0] eq '◧' });
    is @amber.map(*.[1]).unique, ('ok',), 'and is drawn green, as everything in DONE is' or diag @amber.raku;

    # the arrows go where the eye does
    $mm.mode = 'nav';
    my @bea = $mm.visible.grep({ .name eq 'BEA' });
    $mm.sel = $mm.visible.first({ .id eq @bea[0].id }, :k);
    handle-key($mm, Key.new(:name<right>));
    is $mm.selected.id, @bea[1].id, 'right moves along the agent\'s line, to the next job';
    handle-key($mm, Key.new(:name<right>)) for @bea;
    is $mm.selected.id, @bea.tail.id, 'and stops at its end';
    handle-key($mm, Key.new(:name<down>));
    is $mm.selected.name, 'IRIS', 'down goes to the next agent';
    handle-key($mm, Key.new(:name<up>));
    is $mm.selected.name, 'BEA', 'up comes back';
    is $mm.zones{$mm.selected.id}, 'now', 'landing on what that agent has in hand';
    handle-key($mm, Key.new(:name<up>));
    is $mm.selected.name, 'ADA', 'and up again, to the line above';
    my $ada-at = $mm.selected.id;
    handle-key($mm, Key.new(:name<left>));
    is $mm.selected.name, 'ADA', 'left goes back through what that agent has done';
    isnt $mm.selected.id, $ada-at, 'to the run before';
    handle-key($mm, Key.new(:name<left>)) for ^3;
    is $mm.selected.name, 'ADA', 'stopping at the oldest, on the same line';
    handle-key($mm, Key.new(:name<up>));
    is $mm.selected.name, 'ADA', 'as up stops at the first line';
    # the arrows live in two places: the lines, and the prompt beneath
    $mm.sel = $mm.visible.first({ .name eq 'IRIS' }, :k);
    $mm.flash = '';
    my $nv = render($mm, 36, 120).text.lines;
    ok $nv[*-2].contains("IRIS {$mm.selected.short} ❯") && $nv[*-2].contains('↓ to say something to Iris'), 'on the lines, the prompt names the job and says how to reach it' or diag $nv[*-2];
    ok $nv.tail.contains('↓ say something'), 'as the footer does';
    handle-key($mm, Key.new(:name<down>));
    is ($mm.mode, $mm.selected.name), ('input', 'IRIS'), 'down from the last line goes to the prompt, for the same job';
    my $pv = render($mm, 36, 120);
    ok $pv.text.lines[*-2].contains("IRIS {$mm.selected.short} ❯ say something to Iris"), 'which says what it is for' or diag $pv.text.lines[*-2];
    ok $pv.text.lines.tail.contains('↑ the lines'), 'and how to go back';
    my $fr = (2..35).first({ $pv.line($_).contains("❮") });
    is $pv.grid[$fr][$pv.line($fr).index('❮')][1], 'now', 'the cursor on the line stays, saying who the words go to';
    handle-key($mm, Key.new(:name<char>, :text<x>));
    handle-key($mm, Key.new(:name<up>));
    is $mm.mode, 'input', 'with words typed, up stays at the prompt';
    handle-key($mm, Key.new(:name<backspace>));
    handle-key($mm, Key.new(:name<up>));
    is ($mm.mode, $mm.selected.name), ('nav', 'IRIS'), 'up from an empty prompt is back on the lines';
    handle-key($mm, Key.new(:name<up>));
    is $mm.selected.name, 'BEA', 'and up again is the agent above';
    handle-key($mm, Key.new(:name<down>));
    is ($mm.mode, $mm.selected.name), ('nav', 'IRIS'), 'down passes through the agents first';

    # the cursor's job can be acted on, and gone into
    $mm.sel = $mm.visible.first({ .id eq $b.id }, :k);
    $mm.flash = '';
    my $hint = render($mm, 36, 120).text.lines.tail;
    my $acts = render($mm, 36, 120).text.lines.first({ .contains("Bea {$b.short}") });
    ok $acts.ends-with('h hold   s stop'), 'on the lines, the job\'s title carries the keys its state allows' or diag $acts;
    nok $acts.contains('a again'), 'and nothing it does not';
    ok $hint.contains('Enter zoom in'), 'and that Enter goes in';
    handle-key($mm, Key.new(:name<enter>));
    ok $mm.zoom && $mm.mode eq 'input', 'Enter zooms in on the job, ready to be spoken to';
    my @z = render($mm, 36, 120).text.lines;
    ok @z.first({ .starts-with('  BEA') && .contains('❮') }), 'its agent\'s row stays';
    nok @z.first({ .starts-with('  IRIS') }) || @z.first({ .starts-with('  ADA') }), 'the other rows give their room to its conversation';
    handle-key($mm, Key.new(:name<esc>));
    ok $mm.zoom && $mm.mode eq 'nav', 'Esc gives the keys, still on the job';
    $mm.flash = '';
    ok render($mm, 36, 120).text.lines.tail.contains('Esc every line'), 'and says how to come out';
    handle-key($mm, Key.new(:name<esc>));
    ok !$mm.zoom && $mm.mode eq 'nav', 'Esc again shows every line';
    ok render($mm, 36, 120).text.lines.first({ .starts-with('  IRIS') && .contains('│') }), 'as it was';
    $mm.sel = $mm.visible.first({ .name eq 'ADA' }, :k);
    my $kept = $mm.selected.id;
    handle-key($mm, Key.new(:name<char>, :text<t>));
    is ($mm.layout, $mm.selected.id), ('table', $kept), 't goes back to the table, on the same run';
    run-line($mm, '/view lines');
    is ($mm.layout, $mm.selected.id), ('lines', $kept), '/view lines says it as a word';
    ok render($mm, 36, 120).text.lines.first({ .starts-with('  ADA') && .contains('│') }), 'and the lines are drawn';
}

subtest 'an agent is named with a mention, and Tab finishes the name' => {
    my $tf = $home.add('mention-trust.json');
    $tf.spurt(encode-json({ aliases => { b1ll => 'example.test/b1ll', bea => 'example.test/bea', '1da' => 'example.test/1da' } }));
    temp %*ENV<DO_321_TRUST> = $tf.Str;
    is agents-here(), <1da b1ll bea>, 'the agents here are the short names a person chose';
    my $mm = Model.new(:$home);
    $mm.scan;
    $mm.mode = 'input';
    my sub say-line(Str $t) { $mm.input = ''; $mm.cursor = 0; handle-key($mm, Key.new(:name<char>, :text($_))) for $t.comb }
    my sub tab() { handle-key($mm, Key.new(:name<tab>)) }
    say-line('@b');
    ok render($mm, 36, 120).text.lines.tail.contains('@b1ll  @bea   Tab completes'), 'a mention begun lists who it could be' or diag render($mm, 36, 120).text.lines.tail;
    tab();
    is $mm.input, '@b', 'Tab goes as far as the names agree';
    say-line('@b1');
    tab();
    is $mm.input, '@b1ll ', 'and finishes the one it can only be';
    say-line('/start B1');
    tab();
    is $mm.input, '/start b1ll ', 'after /start the name needs no @, in either case';
    say-line('/start --harness fake @1');
    tab();
    is $mm.input, '/start --harness fake @1da ', 'options before it are left as they are';
    say-line('tell @be');
    tab();
    is $mm.input, 'tell @bea ', 'a mention is finished anywhere in the words';
    say-line('@zz');
    ok render($mm, 36, 120).text.lines.tail.contains("no agent here begins '\@zz'"), 'a name no agent has is said so';
    my $sel = $mm.sel;
    say-line('/start b1ll write hel');
    tab();
    is $mm.input, '/start b1ll write hel', 'the request itself is never completed';
    is parse-run-line('/start @b1ll write hello')<agent>, 'b1ll', '/start @b1ll is the agent b1ll';
    is parse-run-line('/start @b1ll write hello')<words>, 'write hello', 'with the request as said';
    run-line($mm, '@B1LL write hello');
    ok $mm.flash.starts-with('not started: trust') && !$mm.flash.contains('@'), 'a line that begins by naming an agent here is work for that agent' or diag $mm.flash;
}

done-testing;
